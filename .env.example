# =============================================================================
# MEOW MEOW - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# FRONTEND (Vite) - Required for app to work
# =============================================================================
# These are used by the frontend React app

# Supabase Project ID (found in Supabase Dashboard > Settings > General)
VITE_SUPABASE_PROJECT_ID="supabase"

# Supabase Anon/Public Key (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SELF_HOSTED_ANON_KEY"

# Supabase URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL="https://www.meow-meow.co.in:8443"

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# =============================================================================
# These are configured in Supabase Dashboard > Settings > Edge Functions > Secrets
# They are NOT stored in .env file - configure them in the Supabase dashboard!

# --- Auto-provided by Supabase (do not set manually) ---
# SUPABASE_URL - Automatically available in edge functions
# SUPABASE_SERVICE_ROLE_KEY - Automatically available in edge functions
# SUPABASE_ANON_KEY - Automatically available in edge functions
# SUPABASE_DB_URL - Automatically available in edge functions

# --- Hugging Face (for AI features) ---
# Get your free token at: https://huggingface.co/settings/tokens
# Used for: Translation (NLLB-200), Photo verification, Voice-to-text
# Secret name in Supabase: HUGGING_FACE_ACCESS_TOKEN
# HUGGING_FACE_ACCESS_TOKEN="hf_your_token_here"

# --- Mailjet (for password reset emails) ---
# Get your keys at: https://app.mailjet.com/account/apikeys
# Secret names in Supabase: MAILJET_API_KEY, MAILJET_SECRET_KEY
# MAILJET_API_KEY="your_mailjet_api_key"
# MAILJET_SECRET_KEY="your_mailjet_secret_key"

# --- Lovable AI (auto-configured if using Lovable Cloud) ---
# Secret name in Supabase: LOVABLE_API_KEY
# LOVABLE_API_KEY="auto-configured-by-lovable"

# =============================================================================
# OPTIONAL: Self-hosted coturn TURN Server (for video call NAT traversal)
# =============================================================================
# Required for video calls to work behind symmetric NAT (corporate/mobile networks)
# See docs/VIDEO-CALLING.md for setup instructions

# VITE_TURN_URL="turn:your-coturn-server.com:3478"
# VITE_TURN_USERNAME="youruser"
# VITE_TURN_CREDENTIAL="yourpassword"

# =============================================================================
# DEPLOYMENT NOTES
# =============================================================================
# 
# For Lovable Deployment:
#   - Frontend env vars are auto-configured
#   - Edge function secrets are in Supabase dashboard
#
# For Self-Hosted / Mobile App Build:
#   1. Copy this file to .env
#   2. Fill in VITE_* variables with your Supabase credentials
#   3. Run: npm run build
#   4. For mobile: npx cap sync
#
# For Edge Functions:
#   - Go to Supabase Dashboard > Settings > Edge Functions
#   - Add secrets there (NOT in .env file)
#
# =============================================================================
